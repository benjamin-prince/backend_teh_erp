api-money.tehtek.com {
	reverse_proxy tehmoney-backend-1:8100
}

admin-money.tehtek.com {
	reverse_proxy tehmoney-admin-1:3100
}

teh-cargo.com, www.teh-cargo.com {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Privacy policy (Meta/WhatsApp compliance) — served by the Next app
	@privacy path /privacy /privacy/*
	handle @privacy {
		reverse_proxy tehtek-shop:3000
	}

	# Temporary landing until the TehCargo site exists
	handle {
		redir https://tehtek.com{uri} temporary
	}

	log {
		output stdout
		format json
	}
}

