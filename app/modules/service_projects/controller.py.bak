"""
app/modules/service_projects/controller.py
Business logic for Service Projects (IT & Security)
"""
from decimal import Decimal
from datetime import datetime
from typing import List, Optional

from fastapi import HTTPException
from sqlalchemy.orm import Session

from app.modules.service_projects.models import (
    ServiceProject, ServiceMilestone, ServiceType,
    ServiceProjectStatus
)
from app.modules.service_projects.schemas import (
    ServiceProjectCreate, ServiceProjectUpdate,
    MilestoneCreate, MilestoneUpdate,
    ServiceTypeCreate, ServiceTypeUpdate,
    SkipBrPayload,
)

TAX_RATE = Decimal("0.1925")


# ── helpers ───────────────────────────────────────────────────────────────────

def _next_reference(db: Session) -> str:
    """Generate SP-YYYYMM-NNNN style reference."""
    prefix = "SP-" + datetime.utcnow().strftime("%Y%m")
    count  = db.query(ServiceProject).filter(
        ServiceProject.reference.like(f"{prefix}%")
    ).count()
    return f"{prefix}-{count + 1:04d}"


def _recalculate(project: ServiceProject) -> None:
    """Recompute subtotal / tax / total from milestones."""
    subtotal = sum(
        (m.quantity * m.unit_price) for m in project.milestones
    )
    project.subtotal = subtotal
    if project.include_tax:
        project.tax_amount      = (subtotal - project.discount_amount) * TAX_RATE
        project.tax_amount      = project.tax_amount.quantize(Decimal("0.01"))
    else:
        project.tax_amount = Decimal("0")
    project.total = (
        subtotal - project.discount_amount + project.tax_amount
    ).quantize(Decimal("0.01"))


def _milestone_total(m: ServiceMilestone) -> Decimal:
    return (m.quantity * m.unit_price).quantize(Decimal("0.01"))


# ── ServiceType CRUD ──────────────────────────────────────────────────────────

def list_service_types(db: Session, active_only: bool = False) -> List[ServiceType]:
    q = db.query(ServiceType)
    if active_only:
        q = q.filter(ServiceType.is_active == True)
    return q.order_by(ServiceType.name).all()


def create_service_type(db: Session, payload: ServiceTypeCreate) -> ServiceType:
    obj = ServiceType(**payload.model_dump())
    db.add(obj)
    db.commit()
    db.refresh(obj)
    return obj


def update_service_type(db: Session, type_id: int, payload: ServiceTypeUpdate) -> ServiceType:
    obj = db.query(ServiceType).filter_by(id=type_id).first()
    if not obj:
        raise HTTPException(404, "ServiceType not found")
    for k, v in payload.model_dump(exclude_none=True).items():
        setattr(obj, k, v)
    db.commit()
    db.refresh(obj)
    return obj


def delete_service_type(db: Session, type_id: int) -> None:
    obj = db.query(ServiceType).filter_by(id=type_id).first()
    if not obj:
        raise HTTPException(404, "ServiceType not found")
    db.delete(obj)
    db.commit()


# ── ServiceProject CRUD ───────────────────────────────────────────────────────

def list_projects(
    db: Session,
    customer_id: Optional[int] = None,
    status: Optional[ServiceProjectStatus] = None,
    skip: int = 0,
    limit: int = 50,
) -> List[ServiceProject]:
    q = db.query(ServiceProject)
    if customer_id:
        q = q.filter(ServiceProject.customer_id == customer_id)
    if status:
        q = q.filter(ServiceProject.status == status)
    return q.order_by(ServiceProject.id.desc()).offset(skip).limit(limit).all()


def get_project(db: Session, project_id: int) -> ServiceProject:
    obj = db.query(ServiceProject).filter_by(id=project_id).first()
    if not obj:
        raise HTTPException(404, "ServiceProject not found")
    return obj


def create_project(db: Session, payload: ServiceProjectCreate) -> ServiceProject:
    data = payload.model_dump(exclude={"milestones"})
    project = ServiceProject(reference=_next_reference(db), **data)
    db.add(project)
    db.flush()   # get project.id before milestones

    for ms in payload.milestones:
        milestone = ServiceMilestone(
            project_id  = project.id,
            description = ms.description,
            quantity    = ms.quantity,
            unit_price  = ms.unit_price,
            sort_order  = ms.sort_order,
        )
        milestone.total = _milestone_total(milestone)
        db.add(milestone)

    db.flush()
    db.refresh(project)
    _recalculate(project)
    db.commit()
    db.refresh(project)
    return project


def update_project(
    db: Session, project_id: int, payload: ServiceProjectUpdate
) -> ServiceProject:
    project = get_project(db, project_id)
    if project.status == ServiceProjectStatus.cancelled:
        raise HTTPException(400, "Cannot update a cancelled project")

    changes = payload.model_dump(exclude_none=True)
    for k, v in changes.items():
        setattr(project, k, v)

    _recalculate(project)
    db.commit()
    db.refresh(project)
    return project


def skip_br(
    db: Session, project_id: int, payload: SkipBrPayload
) -> ServiceProject:
    project = get_project(db, project_id)
    allowed = {
        ServiceProjectStatus.bl_sent,
        ServiceProjectStatus.completed,
    }
    if project.status not in allowed:
        raise HTTPException(
            400, f"skip-br only allowed in: {[s.value for s in allowed]}"
        )
    project.skip_br        = True
    project.skip_br_reason = payload.reason
    project.status         = ServiceProjectStatus.br_received
    db.commit()
    db.refresh(project)
    return project


def generate_invoice(db: Session, project_id: int) -> "Invoice":  # type: ignore[name-defined]
    """
    Create (or return existing) invoice for a service project.
    Mirrors finance module logic — import locally to avoid circular deps.
    """
    from app.modules.finance.models import Invoice, InvoiceStatus
    from app.modules.finance.controller import next_invoice_number

    project = get_project(db, project_id)

    if project.invoice_id:
        inv = db.query(Invoice).filter_by(id=project.invoice_id).first()
        if inv:
            return inv

    allowed = {
        ServiceProjectStatus.br_received,
        ServiceProjectStatus.completed,
        ServiceProjectStatus.signed,
    }
    if project.status not in allowed:
        raise HTTPException(
            400, f"Cannot invoice a project in status '{project.status.value}'"
        )

    # Build line_items_json from milestones
    import json
    items = [
        {
            "description": m.description,
            "quantity":    float(m.quantity),
            "unit_price":  float(m.unit_price),
            "total":       float(m.total),
        }
        for m in project.milestones
    ]

    inv = Invoice(
        invoice_number   = next_invoice_number(db),
        customer_id      = project.customer_id,
        ref_model        = "service_project",
        ref_id           = project.id,
        subtotal         = project.subtotal,
        discount_amount  = project.discount_amount,
        tax_amount       = project.tax_amount,
        total            = project.total,
        paid_amount      = Decimal("0"),
        balance_due      = project.total,
        status           = InvoiceStatus.unpaid,
        line_items_json  = json.dumps(items),
        notes            = project.notes,
    )
    db.add(inv)
    db.flush()

    project.invoice_id = inv.id
    project.status     = ServiceProjectStatus.invoiced
    db.commit()
    db.refresh(inv)
    return inv


def get_invoice(db: Session, project_id: int):
    from app.modules.finance.models import Invoice
    project = get_project(db, project_id)
    if not project.invoice_id:
        raise HTTPException(404, "No invoice generated for this project yet")
    inv = db.query(Invoice).filter_by(id=project.invoice_id).first()
    if not inv:
        raise HTTPException(404, "Invoice record missing")
    return inv


# ── Milestone CRUD ────────────────────────────────────────────────────────────

def list_milestones(db: Session, project_id: int) -> List[ServiceMilestone]:
    get_project(db, project_id)   # 404 guard
    return (
        db.query(ServiceMilestone)
        .filter_by(project_id=project_id)
        .order_by(ServiceMilestone.sort_order, ServiceMilestone.id)
        .all()
    )


def create_milestone(
    db: Session, project_id: int, payload: MilestoneCreate
) -> ServiceMilestone:
    project = get_project(db, project_id)
    m = ServiceMilestone(
        project_id  = project_id,
        description = payload.description,
        quantity    = payload.quantity,
        unit_price  = payload.unit_price,
        sort_order  = payload.sort_order,
    )
    m.total = _milestone_total(m)
    db.add(m)
    db.flush()
    db.refresh(project)
    _recalculate(project)
    db.commit()
    db.refresh(m)
    return m


def update_milestone(
    db: Session, project_id: int, milestone_id: int, payload: MilestoneUpdate
) -> ServiceMilestone:
    project = get_project(db, project_id)
    m = db.query(ServiceMilestone).filter_by(
        id=milestone_id, project_id=project_id
    ).first()
    if not m:
        raise HTTPException(404, "Milestone not found")

    for k, v in payload.model_dump(exclude_none=True).items():
        setattr(m, k, v)

    # Recompute milestone total
    m.total = _milestone_total(m)
    db.flush()
    db.refresh(project)
    _recalculate(project)
    db.commit()
    db.refresh(m)
    return m


def delete_milestone(
    db: Session, project_id: int, milestone_id: int
) -> None:
    project = get_project(db, project_id)
    m = db.query(ServiceMilestone).filter_by(
        id=milestone_id, project_id=project_id
    ).first()
    if not m:
        raise HTTPException(404, "Milestone not found")
    db.delete(m)
    db.flush()
    db.refresh(project)
    _recalculate(project)
    db.commit()
