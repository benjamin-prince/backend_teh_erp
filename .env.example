# TEHTEK ERP Backend — Example Environment File
# Safe to commit. Do not put real secrets here.

DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DATABASE_NAME

SECRET_KEY=replace_with_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

APP_NAME="TEHTEK ERP API"
APP_VERSION="2.0.0"
APP_ENV=production
DEBUG=false

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

ALLOWED_ORIGINS='["https://app.example.com","https://customer.example.com"]'

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PHONE=+237600000000
SUPERADMIN_PASSWORD=replace_with_strong_password
SUPERADMIN_FIRST_NAME=Admin
SUPERADMIN_LAST_NAME=User

# Cloudinary — get keys from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=replace_with_real_secret
CLOUDINARY_UPLOAD_FOLDER=tehtek/shipment_items
# TehCargo WhatsApp Assistant (Meta Cloud API + Claude)
# Phone Number ID ≠ phone number: numeric id from Meta > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=replace_with_system_user_permanent_token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=invent_a_random_string_and_reuse_it_in_meta_webhook_config
WHATSAPP_APP_SECRET=from_meta_app_settings_basic
ANTHROPIC_API_KEY=sk-ant-replace_me
# Personal WhatsApp (digits only) notified on new leads & human-handoff requests.
# Must differ from the bot's own number.
WHATSAPP_ADMIN_NOTIFY_WA_ID=13010000000
